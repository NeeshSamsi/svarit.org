{
  "id": "event",
  "label": "Event",
  "repeatable": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Title",
          "placeholder": ""
        }
      },
      "category": {
        "type": "Select",
        "config": {
          "label": "Category",
          "placeholder": "",
          "options": [
            "Event",
            "Workshop",
            "Scholarship"
          ],
          "default_value": "Event"
        }
      },
      "start_date": {
        "type": "Date",
        "config": {
          "label": "Start Date",
          "placeholder": ""
        }
      },
      "end_date": {
        "type": "Date",
        "config": {
          "label": "End Date",
          "placeholder": ""
        }
      },
      "date_label": {
        "type": "Text",
        "config": {
          "label": "Date Label",
          "placeholder": "7th & 8th November 2002"
        }
      },
      "description": {
        "type": "StructuredText",
        "config": {
          "label": "Description",
          "placeholder": "",
          "multi": "paragraph,strong,em,hyperlink"
        }
      },
      "hero_image": {
        "type": "Image",
        "config": {
          "label": "Hero Image",
          "constraint": {},
          "thumbnails": []
        }
      },
      "venue": {
        "type": "Text",
        "config": {
          "label": "Venue",
          "placeholder": ""
        }
      },
      "venue_map_link": {
        "type": "Link",
        "config": {
          "label": "Venue Map Link",
          "placeholder": "",
          "select": "web",
          "allowTargetBlank": true,
          "allowText": false,
          "repeat": false
        }
      },
      "feature_label": {
        "type": "Text",
        "config": {
          "label": "Feature Label",
          "placeholder": "Featuring:"
        }
      },
      "artists": {
        "type": "Group",
        "config": {
          "label": "Artists",
          "repeat": true,
          "fields": {
            "artist": {
              "type": "Link",
              "config": {
                "label": "Artist",
                "placeholder": "",
                "select": "document",
                "customtypes": [
                  "artist"
                ]
              }
            },
            "featured": {
              "type": "Boolean",
              "config": {
                "label": "Featured on card",
                "placeholder_false": "Not featured",
                "placeholder_true": "Featured",
                "default_value": false
              }
            }
          }
        }
      },
      "ctas": {
        "type": "Group",
        "config": {
          "label": "CTAs",
          "repeat": true,
          "fields": {
            "label": {
              "type": "Text",
              "config": {
                "label": "Label",
                "placeholder": "Learn more"
              }
            },
            "link": {
              "type": "Link",
              "config": {
                "label": "Link",
                "placeholder": "",
                "allowTargetBlank": true,
                "allowText": false,
                "repeat": false
              }
            },
            "style": {
              "type": "Select",
              "config": {
                "label": "Style",
                "placeholder": "",
                "options": [
                  "Outlined",
                  "Primary"
                ],
                "default_value": "Outlined"
              }
            }
          }
        }
      }
    },
    "Body": {
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "rich_text": {
              "type": "SharedSlice"
            },
            "quote": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    }
