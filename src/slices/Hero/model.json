{
  "id": "hero",
  "type": "SharedSlice",
  "name": "Hero",
  "description": "Opening section of the homepage: headline, call to action and a trio of media panels.",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "title": {
          "type": "Text",
          "config": {
            "label": "Title",
            "placeholder": "Ushering in the Next Era of Indian Music"
          }
        },
        "subtitle": {
          "type": "StructuredText",
          "config": {
            "label": "Subtitle",
            "placeholder": "",
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "cta_label": {
          "type": "Text",
          "config": {
            "label": "CTA Label",
            "placeholder": "Learn more"
          }
        },
        "cta_link": {
          "type": "Link",
          "config": {
            "label": "CTA Link",
            "placeholder": "",
            "select": null,
            "allowTargetBlank": true,
            "allowText": false,
            "repeat": false
          }
        },
        "stats": {
          "type": "Text",
          "config": {
            "label": "Stats",
            "placeholder": "20+ Volunteers"
          }
        },
        "images": {
          "type": "Group",
          "config": {
            "label": "Images",
            "repeat": true,
            "fields": {
              "image": {
                "type": "Image",
                "config": {
                  "label": "Image",
                  "constraint": {},
                  "thumbnails": []
                }
              }
            }
          }
        },
        "video": {
          "type": "Link",
          "config": {
            "label": "Video",
            "placeholder": "",
            "select": "media",
            "allowTargetBlank": false,
            "allowText": false,
            "repeat": false
          }
        }
      }
    }
  ]
